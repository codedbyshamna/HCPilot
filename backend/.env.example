# Copy this file to .env and fill in the values.

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: any Groq model that supports tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# Leave unset to use a local SQLite file (backend/aivoa_crm.db).
# PostgreSQL example (start one with Docker, see README):
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/aivoa_crm
